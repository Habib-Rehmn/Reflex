# Offline FAQs remain available with the default provider.
SYSTEM2_PROVIDER=disabled

# Set provider to openai, then supply a key and a Responses-compatible model
# available to your OpenAI project. Never commit .env or paste keys into chat.
OPENAI_API_KEY=
OPENAI_MODEL=
PROVIDER_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048

# Metadata only: prompts and answers are never written to this database.
DATABASE_PATH=data/reflex.db
RETENTION_DAYS=30

# Optional USD estimates. Set all four required fields together, using verified
# rates and the exact model snapshot returned by OpenAI. No rates are assumed.
# PRICING_MODEL=your-model-snapshot
# PRICING_DATE=YYYY-MM-DD
# INPUT_USD_PER_MILLION=your-input-rate
# OUTPUT_USD_PER_MILLION=your-output-rate
# CACHED_INPUT_USD_PER_MILLION=your-cached-input-rate

# Optional Laya System-1 HTTP classifier (separate server; see docs/laya.md).
SYSTEM1_PROVIDER=rules
LAYA_ENDPOINT=http://127.0.0.1:8001/v1/systemone
LAYA_TIMEOUT_SECONDS=30
# LAYA_API_KEY=your-server-key
